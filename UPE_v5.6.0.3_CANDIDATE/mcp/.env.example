# Required. Set in the process environment or secret manager; never commit a real value.
OPENAI_API_KEY=

# Recommended for private framework text. Agents SDK tracing is enabled upstream by default.
OPENAI_AGENTS_DISABLE_TRACING=1

# Defensive logging defaults.
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
