{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Denys/UPE_v5.6/schemas/run-state.schema.json",
  "title": "UPE Runtime Run State",
  "description": "Strict provider-neutral snapshot of one durable harness run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "goal_id",
    "provider",
    "model",
    "reasoning_effort",
    "provider_config_ref",
    "lifecycle_state",
    "started_at",
    "updated_at",
    "iteration_count",
    "budget",
    "current_task_id",
    "approval_state",
    "checkpoint_ref",
    "stop_reason",
    "completion_verdict",
    "completion_evidence_refs",
    "event_seq",
    "last_transition_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "goal_id": {
      "$ref": "#/$defs/stableId"
    },
    "provider": {
      "$ref": "#/$defs/providerName"
    },
    "model": {
      "$ref": "#/$defs/modelName"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "$ref": "#/$defs/shortString"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_config_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/referenceString"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_state": {
      "$ref": "#/$defs/lifecycleState"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "iteration_count": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "$ref": "#/$defs/budgetState"
    },
    "current_task_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/approvalStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/referenceString"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/stopReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "completion_verdict": {
      "$ref": "#/$defs/completionVerdict"
    },
    "completion_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/referenceString"
      }
    },
    "event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "last_transition_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "$ref": "#/$defs/stoppedLifecycleState"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "$ref": "#/$defs/stopReason"
          }
        }
      },
      "else": {
        "properties": {
          "stop_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "allOf": [
              {
                "$ref": "#/$defs/stopReason"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "COMPLETED"
                  }
                }
              }
            ]
          },
          "completion_verdict": {
            "const": "PASS"
          },
          "completion_evidence_refs": {
            "type": "array",
            "minItems": 1
          },
          "checkpoint_ref": {
            "$ref": "#/$defs/referenceString"
          }
        }
      },
      "else": {
        "properties": {
          "completion_verdict": {
            "enum": [
              "FAIL",
              "INSUFFICIENT_EVIDENCE",
              "NOT_EVALUATED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "allOf": [
              {
                "$ref": "#/$defs/stopReason"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "BLOCKED",
                      "MISSING_DEPENDENCY",
                      "REPOSITORY_DIVERGENCE",
                      "UNSAFE_ACTION",
                      "REPEATED_NO_PROGRESS",
                      "REPEATED_INSUFFICIENT_EVIDENCE"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "APPROVAL_REQUIRED"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "approval_state": {
            "enum": [
              "REQUIRED",
              "REQUESTED"
            ]
          },
          "stop_reason": {
            "allOf": [
              {
                "$ref": "#/$defs/stopReason"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "APPROVAL_REQUIRED"
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "approval_state": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "BUDGET_EXHAUSTED"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "budget": {
            "allOf": [
              {
                "$ref": "#/$defs/budgetState"
              },
              {
                "type": "object",
                "properties": {
                  "exhausted_dimensions": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            ]
          },
          "stop_reason": {
            "allOf": [
              {
                "$ref": "#/$defs/stopReason"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "BUDGET_EXHAUSTED"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "FAILED"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "allOf": [
              {
                "$ref": "#/$defs/stopReason"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "FAILED"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "CANCELLED"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "stop_reason": {
            "allOf": [
              {
                "$ref": "#/$defs/stopReason"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "CANCELLED"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "last_transition_id": {
            "$ref": "#/$defs/stableId"
          }
        },
        "required": [
          "last_transition_id"
        ]
      },
      "then": {
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F]+$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F]+$"
    },
    "providerName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F]+$"
    },
    "referenceString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F]+$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "lifecycleState": {
      "enum": [
        "CREATED",
        "INITIALIZING",
        "READY",
        "SELECTING_TASK",
        "EXECUTING",
        "VALIDATING",
        "EVALUATING",
        "CHECKPOINTING",
        "COMPLETED",
        "BLOCKED",
        "BUDGET_EXHAUSTED",
        "APPROVAL_REQUIRED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "stoppedLifecycleState": {
      "enum": [
        "COMPLETED",
        "BLOCKED",
        "BUDGET_EXHAUSTED",
        "APPROVAL_REQUIRED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "completionVerdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE",
        "NOT_EVALUATED"
      ]
    },
    "approvalStatus": {
      "enum": [
        "REQUIRED",
        "REQUESTED"
      ]
    },
    "budgetDimension": {
      "enum": [
        "ITERATIONS",
        "ELAPSED_SECONDS",
        "INPUT_TOKENS",
        "OUTPUT_TOKENS",
        "TOTAL_TOKENS",
        "COST"
      ]
    },
    "budgetValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "elapsed_seconds",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost"
      ],
      "properties": {
        "iterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "budgetState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "consumed",
        "exhausted_dimensions"
      ],
      "properties": {
        "limits": {
          "$ref": "#/$defs/budgetValues"
        },
        "consumed": {
          "$ref": "#/$defs/budgetValues"
        },
        "exhausted_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/budgetDimension"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exhausted_dimensions": {
                "contains": {
                  "const": "ITERATIONS"
                }
              }
            },
            "required": [
              "exhausted_dimensions"
            ]
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "iterations": {
                    "type": "integer"
                  }
                }
              },
              "consumed": {
                "properties": {
                  "iterations": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exhausted_dimensions": {
                "contains": {
                  "const": "ELAPSED_SECONDS"
                }
              }
            },
            "required": [
              "exhausted_dimensions"
            ]
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "elapsed_seconds": {
                    "type": "number"
                  }
                }
              },
              "consumed": {
                "properties": {
                  "elapsed_seconds": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exhausted_dimensions": {
                "contains": {
                  "const": "INPUT_TOKENS"
                }
              }
            },
            "required": [
              "exhausted_dimensions"
            ]
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "input_tokens": {
                    "type": "integer"
                  }
                }
              },
              "consumed": {
                "properties": {
                  "input_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exhausted_dimensions": {
                "contains": {
                  "const": "OUTPUT_TOKENS"
                }
              }
            },
            "required": [
              "exhausted_dimensions"
            ]
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "output_tokens": {
                    "type": "integer"
                  }
                }
              },
              "consumed": {
                "properties": {
                  "output_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exhausted_dimensions": {
                "contains": {
                  "const": "TOTAL_TOKENS"
                }
              }
            },
            "required": [
              "exhausted_dimensions"
            ]
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "total_tokens": {
                    "type": "integer"
                  }
                }
              },
              "consumed": {
                "properties": {
                  "total_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exhausted_dimensions": {
                "contains": {
                  "const": "COST"
                }
              }
            },
            "required": [
              "exhausted_dimensions"
            ]
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {
                  "cost": {
                    "type": "number"
                  }
                }
              },
              "consumed": {
                "properties": {
                  "cost": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "stopReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "code": {
          "enum": [
            "COMPLETED",
            "BLOCKED",
            "APPROVAL_REQUIRED",
            "BUDGET_EXHAUSTED",
            "FAILED",
            "CANCELLED",
            "MISSING_DEPENDENCY",
            "REPOSITORY_DIVERGENCE",
            "UNSAFE_ACTION",
            "REPEATED_NO_PROGRESS",
            "REPEATED_INSUFFICIENT_EVIDENCE"
          ]
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/referenceString"
          }
        }
      }
    }
  }
}
